    "bible:import:kjv": "cd scripts && .venv/bin/python import_bible.py --translation-id kjv --source data/kjv.json --format json",
    "bible:import:net": "cd scripts && .venv/bin/python import_bible.py --translation-id net --source data/NETBIBLE21.epub --format epub",
